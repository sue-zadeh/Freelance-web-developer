{
  "name": "sue-web-studio",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:sue-portfolio": "node dist/sue-portfolio/server/server.mjs",
    "start:prod": "node dist/sue-portfolio/server/server.mjs",
    "dev": "node scripts/preview-server.mjs",
    "test:unit": "ng test --watch=false --include=\"src/app/**/*.spec.ts\"",
    "test:server": "vitest run --config vitest.server.config.ts",
    "verify": "npm run test:server && npm run test:unit && npm run build && node scripts/verify-build.mjs && node scripts/verify-server.mjs"
  },
  "private": true,
  "packageManager": "npm@11.6.3",
  "dependencies": {
    "@angular/common": "21.2.26",
    "@angular/compiler": "21.2.26",
    "@angular/core": "21.2.26",
    "@angular/forms": "21.2.26",
    "@angular/platform-browser": "21.2.26",
    "@angular/platform-server": "21.2.26",
    "@angular/router": "21.2.26",
    "@angular/ssr": "21.2.29",
    "dotenv": "^17.3.1",
    "express": "^5.3.0",
    "pg": "^8.20.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "21.2.29",
    "@angular/cli": "21.2.29",
    "@angular/compiler-cli": "21.2.26",
    "@types/express": "^5.0.1",
    "@types/node": "^20.19.37",
    "@types/pg": "^8.20.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
