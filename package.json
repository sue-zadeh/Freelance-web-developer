{
  "name": "sue-web-studio-release-guardian",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "guardian:baseline": "node challenge/evaluation/evaluate-ref.mjs 56567bbb61d287d445ae3b00ef553fb2c7e0baa4",
    "guardian:final": "node challenge/evaluation/evaluate-ref.mjs HEAD",
    "guardian:evaluate": "node challenge/evaluation/compare.mjs",
    "verify": "npm run test && npm run build && npm run guardian:evaluate && npm audit --omit=dev --audit-level=high",
    "serve:ssr:sue-portfolio": "node dist/sue-portfolio/server/server.mjs",
    "start:prod": "node dist/sue-portfolio/server/server.mjs"
  },
  "private": true,
  "packageManager": "npm@11.6.3",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.1",
    "@popperjs/core": "^2.11.8",
    "aos": "^2.3.4",
    "bootstrap": "^5.3.8",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "pg": "^8.20.0",
    "resend": "^6.18.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.1",
    "@angular/cli": "^21.2.1",
    "@angular/compiler-cli": "^21.2.0",
    "@types/aos": "^3.0.7",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.1",
    "@types/node": "^20.19.37",
    "@types/pg": "^8.20.0",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
