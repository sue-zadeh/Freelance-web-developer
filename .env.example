# Local PostgreSQL connection
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=replace_locally
PGDATABASE=freelance

# Resend key. Never commit the real value.
RESEND_API_KEY=replace_locally

# Comma-separated browser origins allowed to call the API.
CLIENT_ORIGINS=http://localhost:4200,http://localhost:4000

NODE_ENV=development
PORT=4000
